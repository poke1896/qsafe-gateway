# Copy to .env for local overrides. Never commit real secrets.
NODE_ENV=development
PORT=8080
ISSUER=http://localhost:8080
AUDIENCE=qsafe-api
ACCESS_TOKEN_TTL_SECONDS=300
# Must be >= ACCESS_TOKEN_TTL_SECONDS so tokens signed by a retired key keep validating
KEY_GRACE_SECONDS=600
TRUST_PROXY=false
TOKEN_RATE_LIMIT_PER_MINUTE=20
# Required when NODE_ENV=production (min 32 chars). Development falls back to documented dev-only secrets.
# DEMO_READER_SECRET=
# DEMO_ADMIN_SECRET=
# Optional: persistent keys for multi-instance deployments (output of `npm run keys:generate`)
# SIGNING_KEYS_JWKS=
# HYBRID_SECRET_KEY=
